\newcommand{\cvdebugoptions}{\par\textbf{atscv module configuration:}\par Schema: \atscv@schema\par Color: \atscv@color\par Style: \atscv@style\par Layout: \atscv@layout\par Language: \atscv@lang\par}
\newcommand{\cvname}[1]{{\atscvNameSize\bfseries\color{cvprimary} #1\par}}
\newcommand{\cvtitle}[1]{{\atscvTitleSize\color{cvmuted} #1\par}}
\newcommand{\cvemail}[1]{\ifx\relax#1\relax\else {\color{cvtext}#1\par}\fi}
\newcommand{\cvphone}[1]{\ifx\relax#1\relax\else {\color{cvtext}#1\par}\fi}
\newcommand{\cvlocation}[1]{\ifx\relax#1\relax\else {\color{cvtext}#1\par}\fi}
\newcommand{\makecvheader}{}
