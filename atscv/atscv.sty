\geometry{margin=1in}
\IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{\setmainfont{Latin Modern Roman}}
\IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}}{\setsansfont{Latin Modern Sans}}
\defaultfontfeatures{Ligatures=NoCommon}
\hypersetup{hidelinks,unicode=true,pdfencoding=auto}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}

\newcommand{\cvPrimaryColor}{black}
\newcommand{\cvAccentColor}{black}
\newcommand{\cvMutedColor}{black}
\newcommand{\cvNameSize}{\fontsize{20}{24}\selectfont}
\newcommand{\cvTitleSize}{\fontsize{12}{15}\selectfont}
\newcommand{\cvSectionSize}{\fontsize{12}{15}\selectfont}
\newcommand{\cvBodySize}{\fontsize{10.5}{14}\selectfont}
\newlength{\cvSectionSpace}\newlength{\cvEntrySpace}\newlength{\cvBulletSpace}
\setlength{\cvSectionSpace}{0.9em}
\setlength{\cvEntrySpace}{0.55em}
\setlength{\cvBulletSpace}{0.2em}

\ExplSyntaxOn
\keys_define:nn { atscv } {
  mode .tl_set:N = \l__atscv_mode_tl,
  mode .initial:n = modern,
  lang .tl_set:N = \l__atscv_lang_tl,
  lang .initial:n = en,
  atsstrict .bool_set:N = \l__atscv_strict_bool,
  atsstrict .initial:n = true,
  tagging .bool_set:N = \l__atscv_tagging_bool,
  tagging .initial:n = false
}
\NewDocumentCommand{\atscvsetup}{m}{\keys_set:nn{atscv}{#1}}

\cs_new_protected:Npn \atscv_enable_tagging: {
  \bool_if:NT \l__atscv_tagging_bool {
    \cs_if_exist:NTF \pdfmanagement_add:nnn {\RequirePackage{tagpdf}\tagpdfsetup{activate-all,interwordspace=true}}
    {\PackageWarning{atscv}{tagging=true requested but PDF management is unavailable; proceeding without tagging}}
  }
}
\AtBeginDocument{\atscv_enable_tagging:}

\NewDocumentCommand{\cvsetmode}{m}{\keys_set:nn{atscv}{mode=#1}\atscv_mode_apply:}
\cs_new_protected:Npn \atscv_mode_apply: {
  \str_case:VnF \l__atscv_mode_tl {
    {ats}{\colorlet{cvPrimary}{black}\colorlet{cvAccent}{black}\colorlet{cvMuted}{black}\renewcommand{\cvPrimaryColor}{black}\renewcommand{\cvAccentColor}{black}\renewcommand{\cvMutedColor}{black}\renewcommand{\cvSectionSize}{\fontsize{11.5}{14}\selectfont}\setlength{\cvSectionSpace}{0.6em}\setlength{\cvEntrySpace}{0.35em}\setlength{\cvBulletSpace}{0.1em}\titleformat{\section}{\cvSectionSize\bfseries\color{cvPrimary}}{}{0pt}{}\titlespacing*{\section}{0pt}{\cvSectionSpace}{0.2em}}
    {modern}{\colorlet{cvPrimary}{black}\colorlet{cvAccent}{blue!45!black}\colorlet{cvMuted}{black!70}\renewcommand{\cvPrimaryColor}{black}\renewcommand{\cvAccentColor}{blue!45!black}\renewcommand{\cvMutedColor}{black!70}\renewcommand{\cvSectionSize}{\fontsize{12.5}{16}\selectfont}\setlength{\cvSectionSpace}{0.95em}\setlength{\cvEntrySpace}{0.55em}\setlength{\cvBulletSpace}{0.18em}\titleformat{\section}{\cvSectionSize\bfseries\color{cvAccent}}{}{0pt}{}[\titlerule]\titlespacing*{\section}{0pt}{\cvSectionSpace}{0.25em}}
    {executive}{\colorlet{cvPrimary}{black}\colorlet{cvAccent}{black!85}\colorlet{cvMuted}{black!60}\renewcommand{\cvPrimaryColor}{black}\renewcommand{\cvAccentColor}{black!85}\renewcommand{\cvMutedColor}{black!60}\renewcommand{\cvSectionSize}{\fontsize{13}{16}\selectfont}\setlength{\cvSectionSpace}{1em}\setlength{\cvEntrySpace}{0.6em}\setlength{\cvBulletSpace}{0.2em}\titleformat{\section}{\cvSectionSize\bfseries\color{cvAccent}}{}{0pt}{}[\titlerule]\titlespacing*{\section}{0pt}{\cvSectionSpace}{0.3em}}
    {consulting}{\colorlet{cvPrimary}{black}\colorlet{cvAccent}{black}\colorlet{cvMuted}{black!70}\renewcommand{\cvPrimaryColor}{black}\renewcommand{\cvAccentColor}{black}\renewcommand{\cvMutedColor}{black!70}\renewcommand{\cvSectionSize}{\fontsize{12}{15}\selectfont}\setlength{\cvSectionSpace}{0.85em}\setlength{\cvEntrySpace}{0.45em}\setlength{\cvBulletSpace}{0.16em}\titleformat{\section}{\cvSectionSize\bfseries\scshape\color{cvAccent}}{}{0pt}{}\titlespacing*{\section}{0pt}{\cvSectionSpace}{0.2em}}
    {compact}{\colorlet{cvPrimary}{black}\colorlet{cvAccent}{black}\colorlet{cvMuted}{black!70}\renewcommand{\cvPrimaryColor}{black}\renewcommand{\cvAccentColor}{black}\renewcommand{\cvMutedColor}{black!70}\renewcommand{\cvSectionSize}{\fontsize{11}{13}\selectfont}\renewcommand{\cvBodySize}{\fontsize{10}{12}\selectfont}\setlength{\cvSectionSpace}{0.55em}\setlength{\cvEntrySpace}{0.3em}\setlength{\cvBulletSpace}{0.08em}\titleformat{\section}{\cvSectionSize\bfseries\color{cvPrimary}}{}{0pt}{}\titlespacing*{\section}{0pt}{\cvSectionSpace}{0.15em}}
  }{\titleformat{\section}{\cvSectionSize\bfseries\color{black}}{}{0pt}{}}
}
\AtBeginDocument{\atscv_mode_apply:}

