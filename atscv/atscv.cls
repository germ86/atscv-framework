\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{atscv}[2026/05/03 v0.2.0 ATS-safe CV class]
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=atscv,prefix=atscv@}
\DeclareStringOption[general]{schema}
\DeclareStringOption[black]{color}
\DeclareStringOption[modern]{style}
\DeclareStringOption[standard]{layout}
\DeclareStringOption[en]{lang}
\DeclareBoolOption[true]{atsstrict}
\DeclareBoolOption[false]{tagging}
\ProcessKeyvalOptions*
\LoadClass[11pt]{article}
\RequirePackage{atscv}
\makeatletter
\AtBeginDocument{
  \@ifpackageloaded{atscv-schema-general}{}{\RequirePackage{atscv-schema-\atscv@schema}}
  \@ifpackageloaded{atscv-color-black}{}{\RequirePackage{atscv-color-\atscv@color}}
  \@ifpackageloaded{atscv-style-modern}{}{\RequirePackage{atscv-style-\atscv@style}}
  \@ifpackageloaded{atscv-layout-standard}{}{\RequirePackage{atscv-layout-\atscv@layout}}
  \@ifpackageloaded{atscv-lang-en}{}{\RequirePackage{atscv-lang-\atscv@lang}}
}
\makeatother
\endinput
